generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js tables ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Billing ── (see src/lib/billing)
  plan                 String    @default("free") // free | author | pro
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?   // Stripe status: active, trialing, past_due, canceled...
  billingInterval      String?   // month | year
  cancelAtPeriodEnd    Boolean   @default(false)
  wordsReadTotal       Int       @default(0) // lifetime, for reporting

  // Allowance period. Paid plans reset monthly (yearly plans too); free never resets (periodEnd null).
  periodStart      DateTime @default(now())
  periodEnd        DateTime?
  wordsUsed        Int      @default(0) // words read by the reader this period
  grammarWordsUsed Int      @default(0)
  chatUsed         Int      @default(0) // character chat messages
  pitchKitsUsed    Int      @default(0)
  costMicros       Int      @default(0) // AI spend this period, in millionths of a dollar (backstop)

  // Book passes: one-off credit that never expires, used after the monthly allowance.
  passWords        Int @default(0)
  passGrammarWords Int @default(0)
  passChat         Int @default(0)
  passPitchKits    Int @default(0)
  passCostMicros   Int @default(0)

  accounts    Account[]
  sessions    Session[]
  manuscripts Manuscript[]
  aiUsage     AiUsage[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Manuscripts ─────────────────────────────────────────────────

enum ReadingStatus {
  DRAFT    // uploaded, not read yet
  QUEUED
  READING
  DONE
  ERROR
}

model Manuscript {
  id          String        @id @default(cuid())
  userId      String
  title       String
  genre       String?
  audience    String?       // e.g. "adult", "YA", "middle grade"
  authorGoals String?       @db.Text // what the author wants feedback on
  persona     String        @default("enthusiast") // see src/lib/reader/personas.ts
  wordCount   Int           @default(0)
  status      ReadingStatus @default(DRAFT)
  draft       Int           @default(1) // which draft this is: goes up each time a revised draft is imported
  error       String?       @db.Text
  errorCode   String?       // "LIMIT" when a read paused because the plan's allowance ran out
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  report        BookReport?
  conversations Conversation[]
  threads       ReaderThread[]
  characters    Character[]
  facts         StoryFact[]
  pitchKit      PitchKit?
  snapshots     DraftSnapshot[]

  @@index([userId])
}

model Chapter {
  id           String   @id @default(cuid())
  manuscriptId String
  index        Int      // 0-based reading order
  title        String
  content      String   @db.Text // plain text: what the AI reads and notes anchor to (derived from `doc`)
  doc          Json?    // formatted document (TipTap/ProseMirror JSON); null for chapters not yet opened in the editor
  wordCount    Int
  createdAt    DateTime @default(now())
  contentUpdatedAt DateTime @default(now()) // last time the text changed
  intent       String?  @db.Text // what the author wants the reader to feel/know/suspect here (checked after reading)

  manuscript    Manuscript     @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  review        ChapterReview?
  conversations Conversation[]
  threadsRaised   ReaderThread[] @relation("raisedIn")
  threadsResolved ReaderThread[] @relation("resolvedIn")
  facts           StoryFact[]

  @@unique([manuscriptId, index])
}

// What the AI reader experienced in one chapter.
model ChapterReview {
  id         String        @id @default(cuid())
  chapterId  String        @unique
  status     ReadingStatus @default(QUEUED)
  error      String?       @db.Text

  reaction   String?       @db.Text // first-person, as-I-read reaction
  summary    String?       @db.Text // what happened, as the reader understood it
  engagement Int?          // 1–10: how much the reader wanted to keep going
  confusion  Int?          // 1–10: how lost the reader was (1 = always clear)
  driftQuote  String?      @db.Text // the passage where attention slipped most (drop-off map)
  driftReason String?      @db.Text
  strengths  Json?         // string[]
  questions  Json?         // string[] — open questions the reader is carrying
  predictions Json?        // string[] — what the reader thinks will happen
  memory     String?       @db.Text // running "reader memory" handed to the next chapter
  readAt     DateTime?     // when the read started; content edited after this means the notes are out of date
  intentCheck   Json?      // { landed: "yes"|"partly"|"no", explanation } when the chapter had an intent
  revisionCheck Json?      // { previousEngagement, notes: [{quote, comment, authorStatus, verdict, explanation}] } on a re-read

  model        String?
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  notes   Note[]
}

enum NoteKind {
  REACTION // "I gasped here"
  PRAISE   // this is working, keep it
  ISSUE    // this isn't working
}

enum NoteStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// An inline note anchored to a passage of the chapter.
model Note {
  id          String     @id @default(cuid())
  reviewId    String
  kind        NoteKind
  category    String     // pacing, clarity, character, dialogue, prose, plot, worldbuilding, continuity, tension, voice
  severity    Int        @default(2) // 1 = minor, 2 = notable, 3 = major
  quote       String     @db.Text   // exact passage from the chapter
  startOffset Int?       // character offsets into Chapter.content (null if the quote couldn't be located)
  endOffset   Int?
  comment     String     @db.Text   // what the reader felt / why it isn't working
  suggestion  String?    @db.Text   // how to fix it
  status      NoteStatus @default(OPEN)
  createdAt   DateTime   @default(now())

  review ChapterReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// Whole-book developmental read, written after the last chapter.
model BookReport {
  id           String        @id @default(cuid())
  manuscriptId String        @unique
  status       ReadingStatus @default(QUEUED)
  error        String?       @db.Text
  content      Json?         // see BookReportSchema in src/lib/reader/schemas.ts
  model        String?
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
}

// ─── Reader journey ──────────────────────────────────────────────

enum ThreadKind {
  QUESTION   // something the reader is wondering about
  PREDICTION // something the reader expects to happen
}

enum ThreadOutcome {
  OPEN      // still carried
  ANSWERED  // a question the story answered
  CONFIRMED // a prediction that came true (a twist the reader saw coming)
  REFUTED   // a prediction the story overturned (a surprise)
}

// A question or prediction the reader carried from one chapter onward.
model ReaderThread {
  id               String        @id @default(cuid())
  manuscriptId     String
  kind             ThreadKind
  text             String        @db.Text
  raisedChapterId  String
  resolvedChapterId String?
  outcome          ThreadOutcome @default(OPEN)
  resolution       String?       @db.Text // how it was answered / what actually happened
  createdAt        DateTime      @default(now())

  manuscript     Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  raisedChapter  Chapter    @relation("raisedIn", fields: [raisedChapterId], references: [id], onDelete: Cascade)
  resolvedChapter Chapter?  @relation("resolvedIn", fields: [resolvedChapterId], references: [id], onDelete: SetNull)

  @@index([manuscriptId])
}

// ─── Characters ──────────────────────────────────────────────────

model Character {
  id           String   @id @default(cuid())
  manuscriptId String
  name         String
  aliases      Json?    // string[]: other names the text uses ("Mara", "Mrs. Holt")
  role         String?  // protagonist, antagonist, supporting…
  summary      String?  @db.Text // who they are, drawn from the manuscript
  notes        String?  @db.Text // the author's own notes / character bible

  // Profile. Pronouns are passed to every AI prompt so the reader never misgenders anyone.
  pronouns     String?  // "she/her", "they/them"…
  age          String?  // free text: "17", "mid-forties"
  appearance   String?  @db.Text
  personality  String?  @db.Text
  wants        String?  @db.Text // what they want
  fears        String?  @db.Text // what they fear / what stands in their way
  backstory    String?  @db.Text
  voice        String?  @db.Text // how they talk
  imageUpdatedAt DateTime? // set when a picture is uploaded; also busts the image URL cache

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manuscript    Manuscript      @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  image         CharacterImage?

  @@index([manuscriptId])
}

// A character's picture, kept apart so ordinary character queries never load the bytes.
model CharacterImage {
  characterId String   @id
  data        Bytes    // JPEG, PNG or WebP, resized in the browser before upload
  type        String   // image/jpeg | image/png | image/webp
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// ─── Conversations (editor chat — off in v1 — and character chat) ─

model Conversation {
  id           String   @id @default(cuid())
  manuscriptId String
  chapterId    String?
  characterId  String?
  asOfChapter  Int?     // character chat: what the character knows, up to this chapter (1-based); null = whole book
  mode         String?  // character chat: interview mode (src/lib/reader/interview.ts); null = open conversation
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  chapter    Chapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  character  Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([manuscriptId])
  @@index([characterId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Story bible & continuity ────────────────────────────────────

// A concrete fact the reader learned in a chapter (a trait, relationship, injury, date, rule
// of the world...). Later chapters are checked against the facts from earlier ones.
model StoryFact {
  id           String   @id @default(cuid())
  manuscriptId String
  chapterId    String   // where it was established
  subject      String   // who or what it's about: "Mara", "The Ghost Knights", "Timeline"
  category     String   // character | place | object | timeline | world
  fact         String   @db.Text
  createdAt    DateTime @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([manuscriptId])
  @@index([chapterId])
}

// ─── Draft history ───────────────────────────────────────────────

// How the read stood for one draft, kept when a revised draft replaces it (or a fresh read
// starts over), so the next draft's read can be compared with it. See src/lib/reader/drafts.ts.
model DraftSnapshot {
  id           String   @id @default(cuid())
  manuscriptId String
  draft        Int      // the draft number this records
  reason       String   // reimport | fresh_read
  data         Json     // SnapshotData
  createdAt    DateTime @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)

  @@index([manuscriptId, createdAt])
}

// ─── Pitch kit ───────────────────────────────────────────────────

// Logline, blurb, synopsis and query letter, written from the reader's experience of the book.
model PitchKit {
  id           String        @id @default(cuid())
  manuscriptId String        @unique
  status       ReadingStatus @default(QUEUED)
  error        String?       @db.Text
  content      Json?         // see PitchKitSchema in src/lib/reader/schemas.ts
  model        String?
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
}

// ─── Billing & cost control ──────────────────────────────────────

// Every AI call, with its real cost. Feeds the per-user spend ceiling and the app-wide daily budget.
// userId is null for free sample reads (no account), and once a user deletes their account:
// the row stays, anonymous, so the day's spend is still counted.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  manuscriptId     String?
  kind             String   // read | report | grammar | chat | characters | pitch | editor
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicros       Int      @default(0)
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Stripe webhook events already handled (webhooks can be delivered more than once).
model StripeEvent {
  id        String   @id // Stripe event id
  type      String
  createdAt DateTime @default(now())
}

// ─── Free sample reads ───────────────────────────────────────────

// One chapter read for someone without an account (/try). Deleted after TRIAL_RETENTION_DAYS.
model TrialRead {
  id        String        @id @default(cuid())
  ipHash    String        // salted hash of the visitor's address, for rate limits; never the address
  title     String?
  genre     String?
  content   String        @db.Text
  wordCount Int
  midBook   Boolean       @default(false) // from partway through the book, rather than an opening
  status    ReadingStatus @default(QUEUED)
  error     String?       @db.Text
  result    Json?         // see TrialResult in src/lib/trialRead.ts
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// ─── Background jobs ─────────────────────────────────────────────

// Long-running AI work (whole-book reads, re-reads, sample reads), run by a worker so it
// survives restarts and request time limits. See src/lib/jobs.
model Job {
  id        String    @id @default(cuid())
  kind      String    // read_manuscript | reread_chapter | pitch_kit | trial_read
  payload   Json
  status    String    @default("queued") // queued | running | done | failed
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lockedAt  DateTime? // heartbeat while running; a stale one means the worker died
  lockedBy  String?
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}
