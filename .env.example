# Postgres connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beta_reader"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# OAuth providers (create apps at github.com/settings/developers and console.cloud.google.com)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: sign in with just an email address, no OAuth app needed.
AUTH_DEV_LOGIN="true"

# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=""
# Model used for reading and character chat
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Smaller, cheaper model for grammar & style and for finding characters
ANTHROPIC_LINE_MODEL="claude-haiku-5-5"

# ── Billing (Stripe) ── leave blank to run without payments (buttons show "Coming soon")
# Use test-mode keys (sk_test_...) until launch. See README → Billing.
STRIPE_SECRET_KEY=""
# From the webhook endpoint you add in Stripe (or `stripe listen` locally): whsec_...
STRIPE_WEBHOOK_SECRET=""
# Price ids (price_...) for each product you create in Stripe
STRIPE_PRICE_AUTHOR_MONTHLY=""
STRIPE_PRICE_AUTHOR_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BOOK_PASS=""
# Public address of the app, used for Stripe's return links (e.g. https://app.example.com)
APP_URL="http://localhost:3000"

# ── Cost control ──
# App-wide AI spend per day (UTC), in dollars. New AI work pauses for everyone once it's reached.
AI_DAILY_BUDGET_USD="50"
